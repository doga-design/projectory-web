# Copy to `.env.local` for local use, or set on the Vercel project for a deploy.
#
# VITE_-prefixed variables are read at BUILD time by Vite and inlined into the public
# bundle — never put a secret in one. Variables without the prefix (the server-only
# section below) are read only by the functions in api/ and never reach the browser.

# Set to `off` to skip the branded LoadingScreen entirely.
# Useful for measuring its cost: build a preview with it off and re-run Lighthouse.
# Anything other than `off` (including unset) keeps the loader.
VITE_LOADING_SCREEN=on

# ── Server-only (NOT VITE_-prefixed, never reach the browser) ─────────────────
# Website lead forms → Pipedrive (api/lead-form.cjs). Set on the Vercel project for a deploy,
# and in `.env.local` to run `npm run setup:pipedrive`.
# Leave unset and the forms keep working through the Web3Forms email backup.

# The "yourcompany" part of https://yourcompany.pipedrive.com
PIPEDRIVE_COMPANY_DOMAIN=

# Pipedrive → Settings → Personal preferences → API. New leads are owned by this user.
PIPEDRIVE_API_TOKEN=
